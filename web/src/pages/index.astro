---
import BaseLayout from "../layouts/BaseLayout.astro";

const chromeStoreUrl =
  "https://chromewebstore.google.com/detail/solstice/boegcpnmpagdbebakchpambpfggghjhe";
const githubUrl = "https://github.com/seanoliver/solstice";
---

<BaseLayout
  title="Solstice — A calmer world clock for your new tab"
  description="See daylight, working hours, and local time across every place you care about. Solstice is a calm world clock for your Chrome new tab."
>
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="Solstice home">
        <img src="/icon-128.png" alt="" width="30" height="30" />
        <span>Solstice</span>
      </a>

      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#tour">Tour</a>
        <a href="#faq">FAQ</a>
      </div>

      <div class="nav-actions">
        <a class="text-link" href={githubUrl}>GitHub</a>
        <a class="button" href={chromeStoreUrl}>Add to Chrome</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">A clearer way to share a planet</p>
        <h1>Know when they're awake. <span>Without doing the math.</span></h1>
        <p class="hero-copy">
          Solstice turns your new tab into a calm map of time—showing local
          hours, daylight, and the shape of everyone's day in one glance.
        </p>
        <div class="hero-actions">
          <a class="button" href={chromeStoreUrl}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Add to Chrome
          </a>
          <a class="button button-secondary" href="#tour">See how it works</a>
        </div>
        <p class="hero-note">Free · No account · No analytics</p>

        <figure class="product-frame">
          <div class="frame-bar" aria-hidden="true">
            <i></i><i></i><i></i>
            <span>New tab</span>
          </div>
          <img
            src="/screenshots/hero.png"
            alt="Solstice showing local time, four timezone cards, and daylight bands across a 24-hour timeline"
            width="1408"
            height="1056"
            loading="eager"
          />
        </figure>

        <div class="band-key" aria-label="Timeline color key">
          <span><i style="background: var(--morning)"></i>Morning</span>
          <span><i style="background: var(--work)"></i>Work</span>
          <span><i style="background: var(--evening)"></i>Evening</span>
          <span><i style="background: var(--night)"></i>Night</span>
        </div>
      </div>
    </section>

    <aside class="trust-strip" aria-label="Product principles">
      <div class="trust-grid container">
        <div class="trust-item">
          <strong>Real daylight</strong>
          <span>Calculated for each city</span>
        </div>
        <div class="trust-item">
          <strong>Any city</strong>
          <span>Add the people and places that matter</span>
        </div>
        <div class="trust-item">
          <strong>Your data</strong>
          <span>Settings stay in your browser</span>
        </div>
        <div class="trust-item">
          <strong>Open source</strong>
          <span>Quiet software, inspectable by design</span>
        </div>
      </div>
    </aside>

    <section class="section" id="features">
      <div class="container">
        <div class="section-heading">
          <p class="section-kicker">Time you can see</p>
          <h2>A world clock that reads like a weather map.</h2>
          <p>
            Colored bands turn abstract offsets into something immediate: who
            is waking up, who is working, and whose day is winding down.
          </p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <span class="feature-number">01</span>
            <h3>Glance, don't calculate</h3>
            <p>
              One screen answers “what time is it there?” and “is now a good
              time?” without counting backward on your fingers.
            </p>
            <div class="mini-timeline" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </article>

          <article class="feature-card">
            <span class="feature-number">02</span>
            <h3>Daylight, for real</h3>
            <p>
              Sunrise and sunset are calculated from each city's coordinates,
              so the bands follow the season instead of a generic guess.
            </p>
            <div class="mini-timeline" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </article>

          <article class="feature-card">
            <span class="feature-number">03</span>
            <h3>Quiet by design</h3>
            <p>
              No feeds, weather widgets, headlines, or attention traps. Open a
              tab, get your bearings, and keep moving.
            </p>
            <div class="mini-timeline" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="tour">
      <div class="container">
        <div class="section-heading centered">
          <p class="section-kicker">Feature tour</p>
          <h2>From “what time?” to “what time works?”</h2>
          <p>
            Solstice is useful in a second, but there is more waiting when you
            need to plan.
          </p>
        </div>

        <div class="tour-list">
          <article class="tour-row">
            <div class="tour-media">
              <img
                src="/screenshots/scrub.png"
                alt="Solstice scrubbed to noon with every timezone updated to the same instant"
                width="1408"
                height="1056"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tour-copy">
              <p class="section-kicker">Plan across zones</p>
              <h3>Drag the day to find a humane hour.</h3>
              <p>
                Grab any timeline marker and every clock moves with it. See the
                same instant everywhere, then reset to now when you're done.
              </p>
              <ul>
                <li>Every zone stays locked to one shared moment</li>
                <li>Quarter-hour snapping makes meeting times easy to read</li>
                <li>Date chips make tomorrow and yesterday explicit</li>
              </ul>
            </div>
          </article>

          <article class="tour-row">
            <div class="tour-media">
              <img
                src="/screenshots/edit.png"
                alt="Solstice edit panel with reorderable zones and a city search field"
                width="1408"
                height="1056"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tour-copy">
              <p class="section-kicker">Make it yours</p>
              <h3>Keep the places—or people—you think about.</h3>
              <p>
                Add cities in seconds, drag them into order, or rename London
                to the teammate who lives there. Your setup returns with every
                new tab.
              </p>
              <ul>
                <li>Search for essentially any city on earth</li>
                <li>Rename, reorder, and remove zones</li>
                <li>Switch every clock between 12- and 24-hour time</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="privacy">
      <div class="container">
        <div class="privacy-panel">
          <div class="privacy-mark" aria-hidden="true">
            <div class="privacy-orbit">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M7 10V7a5 5 0 0 1 10 0v3M6 10h12v10H6V10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                <circle cx="12" cy="15" r="1.4" fill="currentColor"></circle>
              </svg>
            </div>
          </div>
          <div class="privacy-copy">
            <p class="section-kicker">Private by default</p>
            <h2>Your new tab doesn't need to become someone else's data.</h2>
            <p>
              Solstice has no accounts, analytics, advertising, or tracking.
              Your zones and preferences stay in your browser.
            </p>
            <ul class="privacy-list">
              <li>Location permission is optional</li>
              <li>Daylight calculations happen locally</li>
              <li>The source is public and inspectable</li>
            </ul>
            <a class="text-link" href="/privacy/">
              Read the privacy policy
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <div class="section-heading centered">
          <p class="section-kicker">FAQ</p>
          <h2>A few things worth knowing.</h2>
        </div>

        <div class="faq-list">
          <details>
            <summary>What does Solstice change?</summary>
            <div class="faq-answer">
              Solstice replaces Chrome's default new-tab page. Your bookmarks,
              browsing history, search engine, and other browser settings are
              untouched.
            </div>
          </details>
          <details>
            <summary>Why does it ask for location access?</summary>
            <div class="faq-answer">
              Location is used to label your local zone and calculate its
              daylight accurately. Permission is optional; Solstice falls back
              to an approximate IP location or your system time zone. See the
              <a href="/privacy/">full privacy policy</a>.
            </div>
          </details>
          <details>
            <summary>Does my setup sync between computers?</summary>
            <div class="faq-answer">
              Not currently. Zones and preferences live only in the browser
              where you set them. That keeps the extension account-free, though
              export and import are on the roadmap.
            </div>
          </details>
          <details>
            <summary>Can I use Solstice without installing the extension?</summary>
            <div class="faq-answer">
              Not yet. The website starts as a home for the extension, but the
              plan is to grow it into useful standalone time and daylight tools.
            </div>
          </details>
          <details>
            <summary>Is Solstice free?</summary>
            <div class="faq-answer">
              Yes. Solstice is currently free and open source under the MIT
              license. You can inspect the code or contribute on
              <a href={githubUrl}>GitHub</a>.
            </div>
          </details>
        </div>
      </div>
    </section>

    <section class="final-wrap">
      <div class="container">
        <div class="final-cta">
          <p class="section-kicker">Your next tab, calmer</p>
          <h2>Get your bearings at a glance.</h2>
          <p>
            Add Solstice to Chrome, choose the places you care about, and let
            the shape of the day do the math.
          </p>
          <a class="button" href={chromeStoreUrl}>Add Solstice to Chrome</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner container">
      <span>© 2026 Sean Oliver · Open source under MIT</span>
      <div class="footer-links">
        <a href={githubUrl}>GitHub</a>
        <a href="/privacy/">Privacy</a>
        <a href="mailto:solstice@seanoliver.dev">Contact</a>
      </div>
    </div>
  </footer>
</BaseLayout>
