---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveDemo from "../components/LiveDemo.astro";

const chromeStoreUrl =
  "https://chromewebstore.google.com/detail/solstice/boegcpnmpagdbebakchpambpfggghjhe";
const githubUrl = "https://github.com/seanoliver/solstice";
---

<BaseLayout
  title="Solstice — See who's awake"
  description="A new tab for Chrome with your time zones and real daylight. Free, no account."
>
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="Solstice home">
        <img src="/icon-128.png" alt="" width="30" height="30" />
        <span>Solstice</span>
      </a>
      <div class="nav-actions">
        <a class="text-link" href={githubUrl}>GitHub</a>
      </div>
    </nav>
  </header>

  <main class="landing container">
    <section class="hero">
      <h1>See who's awake.</h1>
      <p class="hero-copy">A new tab for Chrome with your time zones and real daylight.</p>
      <div class="hero-actions">
        <a class="button" href={chromeStoreUrl}>Add to Chrome</a>
        <span class="hero-note">Free · no account</span>
      </div>
    </section>

    <LiveDemo />

    <ul class="facts">
      <li><strong>Real daylight.</strong> Sunrise and sunset for each city.</li>
      <li><strong>Plan a call.</strong> Drag the timeline; every clock follows.</li>
      <li><strong>Private.</strong> No account, no analytics.</li>
    </ul>
  </main>

  <footer class="site-footer">
    <div class="footer-inner container">
      <span>© 2026 Sean Oliver · Open source under MIT</span>
      <div class="footer-links">
        <a href="/privacy/">Privacy</a>
        <a href={githubUrl}>GitHub</a>
        <a href="mailto:solstice@seanoliver.dev">Contact</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .landing {
    padding-bottom: 96px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 72px 0 56px;
    text-align: center;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .hero-copy {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding-top: 6px;
  }

  .hero-note {
    color: var(--muted);
    font: 500 13px/1 var(--mono);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    width: min(100%, 1100px);
    margin: 64px auto 0;
    padding: 0;
    color: var(--muted);
    list-style: none;
  }

  .facts strong {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .hero {
      padding: 48px 0 40px;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 48px;
    }
  }
</style>
