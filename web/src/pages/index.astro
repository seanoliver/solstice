---
import Head from "../components/Head.astro";
import "../../../newtab.css";
import "../styles/cta.css";
import { CHROME_STORE_URL } from "../consts";
---

<!doctype html>
<html lang="en" data-no-detect>
  <head>
    <Head
      title="Solstice — A calmer world clock for your new tab"
      description="See daylight, working hours, and local time across every place you care about. Solstice is a calm world clock for your Chrome new tab."
    />
    <script is:inline>
      try {
        if (localStorage.getItem("webCtaDismissed") === "1") {
          document.documentElement.dataset.ctaDismissed = "";
        }
      } catch {}
    </script>
  </head>
  <body>
    <main id="app">
      <div class="cta-banner" data-cta-banner>
        <span>This is Solstice, running on the web. Make it your new tab.</span>
        <a class="cta-btn" href={CHROME_STORE_URL} target="_blank" rel="noopener" data-cta-link>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v8.6l3-3 1.1 1.1L8 12.6 3.9 7.7 5 6.6l3 3V1zM2 13.5h12V15H2z"/></svg>
          Add to Chrome
        </a>
        <button class="cta-close" type="button" aria-label="Dismiss Add to Chrome banner" data-cta-close>×</button>
      </div>
    </main>
    <script>
      import "../scripts/cta";
      import "../../../newtab.js";
      import "../scripts/footer";
    </script>
  </body>
</html>
